# Public Convex deployment URL. The deployment is also configured as the
# frontend default in src/lib/convex.ts.
VITE_CONVEX_URL=https://tough-pelican-388.convex.cloud

# Optional: explicit HTTP Actions URL. If omitted, the .convex.cloud URL above
# is translated to the matching .convex.site origin for API examples.
# VITE_CONVEX_SITE_URL=https://tough-pelican-388.convex.site

# Configure these as Convex deployment environment variables (never in Vite):
# AUTH_GITHUB_ID=...
# AUTH_GITHUB_SECRET=...
# SITE_URL=https://your-dashboard-domain.example
# STRIPE_SECRET_KEY=...
# STRIPE_PREMIUM_PRICE_ID=...
# STRIPE_WEBHOOK_SECRET=...
